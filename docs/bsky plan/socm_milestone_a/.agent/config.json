{
  "lanes": {
    "socm": {
      "allow": [
        "docs/social/**",
        "artifacts/social/**",
        "scripts/social/**"
      ],
      "budgets": {
        "maxFiles": 10,
        "maxLoc": 200,
        "maxJobs": 2
      },
      "runner": {
        "writer": "AUTO-BOTS-SOCM-ALFA",
        "monitor": "IONA-CATS-SOCM-BETA"
      }
    }
  },
  "gate": {
    "signal": "@cat ready-for-gate"
  },
  "killSwitch": ".agent/LOCK",
  "evidence": ".agent/EVIDENCE.log"
}