    },
    {
      "createdAt": "2025-10-08T12:03:50.539558Z",
      "updatedAt": "2025-10-08T12:03:50.539558Z",
      "createdBy": "fubumaki@gmail.com",
      "updatedBy": "fubumaki@gmail.com",
      "id": "0199c3b4-ce8b-7895-830c-1797ddf03a27",
      "data": {
        "description": "SRE-style burn-rate monitoring for error budget and P95 latency",
        "layout": [
          {
            "h": 3,
            "i": "error-burn-5m",
            "moved": false,
            "static": false,
            "w": 12,
            "x": 0,
            "y": 0
          },
          {
            "h": 3,
            "i": "error-burn-30m",
            "moved": false,
            "static": false,
            "w": 12,
            "x": 12,
            "y": 0
          },
          {
            "h": 3,
            "i": "latency-5m",
            "moved": false,
            "static": false,
            "w": 12,
            "x": 0,
            "y": 3
          },
          {
            "h": 3,
            "i": "latency-30m",
            "moved": false,
            "static": false,
            "w": 12,
            "x": 12,
            "y": 3
          }
        ],
        "tags": [
          "bosscat",
          "slo",
          "burn-rate",
          "sre"
        ],
        "title": "BossCat SLO Dashboard",
        "version": "v5",
        "widgets": [
          {
            "description": "Fast burn-rate window for error budget (5m)",
            "id": "error-burn-5m",
            "panelTypes": "graph",
            "query": {
              "promQueries": [
                {
                  "disabled": false,
                  "legend": "Error Burn Rate",
                  "query": "(sum(rate(http_server_request_duration_seconds_count{status_code=~\"5..\",service=\"frontend\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{service=\"frontend\"}[5m]))) / 0.01"
                }
              ],
              "queryType": "promql"
            },
            "thresholds": [
              {
                "color": "red",
                "index": 0,
                "isVisible": true,
                "value": 14.4
              }
            ],
            "title": "Error Burn Rate (5m) - Critical",
            "yAxisUnit": "none"
          },
          {
            "description": "Slow burn-rate window for error budget (30m)",
            "id": "error-burn-30m",
            "panelTypes": "graph",
            "query": {
              "promQueries": [
                {
                  "disabled": false,
                  "legend": "Error Burn Rate",
                  "query": "(sum(rate(http_server_request_duration_seconds_count{status_code=~\"5..\",service=\"frontend\"}[30m])) / sum(rate(http_server_request_duration_seconds_count{service=\"frontend\"}[30m]))) / 0.01"
                }
              ],
              "queryType": "promql"
            },
            "thresholds": [
              {
                "color": "yellow",
                "index": 0,
                "isVisible": true,
                "value": 6
              }
            ],
            "title": "Error Burn Rate (30m) - Warning",
            "yAxisUnit": "none"
          },
          {
            "description": "Fast window P95 latency (5m)",
            "id": "latency-5m",
            "panelTypes": "graph",
            "query": {
              "promQueries": [
                {
                  "disabled": false,
                  "legend": "P95 Latency",
                  "query": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service=\"frontend\"}[5m])) by (le))"
                }
              ],
              "queryType": "promql"
            },
            "thresholds": [
              {
                "color": "red",
                "index": 0,
                "isVisible": true,
                "value": 0.3
              }
            ],
            "title": "P95 Latency (5m) - Critical",
            "yAxisUnit": "s"
          },
          {
            "description": "Slow window P95 latency (30m)",
            "id": "latency-30m",
            "panelTypes": "graph",
            "query": {
              "promQueries": [
                {
                  "disabled": false,
                  "legend": "P95 Latency",
                  "query": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service=\"frontend\"}[30m])) by (le))"
                }
              ],
              "queryType": "promql"
            },
            "thresholds": [
              {
                "color": "yellow",
                "index": 0,
                "isVisible": true,
                "value": 0.3
              }
            ],
            "title": "P95 Latency (30m) - Warning",
            "yAxisUnit": "s"
          }
        ]
      },
      "locked": false,
      "org_id": "0199b291-f590-7d19-a3d0-2d3254d02dda"
    },
    {
      "createdAt": "2025-10-08T13:58:22.232587Z",
      "updatedAt": "2025-10-08T13:58:22.232587Z",
      "createdBy": "fubumaki@gmail.com",
      "updatedBy": "fubumaki@gmail.com",
      "id": "0199c41d-a918-79fd-a039-f5a78b2a80e4",
      "data": {
        "data": {
          "widgets": [
            {
              "description": "High-priority error logs for immediate triage",
              "spec": {
                "columns": [
                  "timestamp",
                  "resource.service.name",
                  "message",
                  "attribute.trace_id"
                ],
                "query": "severity = 'ERROR' OR level = 'error'"
              },
              "title": "Enterprise • Logs • Error Triage",
              "type": "logs"
            },
            {
              "description": "Security-related log patterns for audit",
              "spec": {
                "columns": [
                  "timestamp",
                  "resource.service.name",
                  "message",
                  "attribute.http.status_code"
                ],
                "query": "message CONTAINS 'auth' OR message CONTAINS 'denied' OR message CONTAINS 'forbidden'"
              },
              "title": "Enterprise • Logs • Security Signals",
              "type": "logs"
            },
            {
              "description": "Slow or failing endpoints requiring attention",
              "spec": {
                "columns": [
                  "name",
                  "duration_ms",
                  "span.status_code",
                  "attribute.http.method",
                  "attribute.http.route"
                ],
                "query": "resource.service.name = 'frontend' AND (span.status_code = 'ERROR' OR duration_ms > 500)"
              },
              "title": "Enterprise • Traces • Hot Endpoints",
              "type": "traces"
            },
            {
              "description": "IONA canary test traces for pipeline validation",
              "spec": {
                "columns": [
                  "name",
                  "duration_ms",
                  "span.status_code",
                  "attribute.canary",
                  "attribute.env"
                ],
                "query": "resource.service.name = 'frontend' AND (name = 'iona-canary-span' OR attribute.canary = '1')"
              },
              "title": "Enterprise • Traces • Canary Spans",
              "type": "traces"
            },
            {
              "description": "OTel collector ingest rate (5min window)",
              "spec": {
                "promql": "rate(otelcol_receiver_accepted_spans[5m])"
              },
              "title": "Enterprise • Metrics • Collector Ingest Pulse",
              "type": "metrics"
            },
            {
              "description": "95th percentile request latency",
              "spec": {
                "promql": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le))"
              },
              "title": "Enterprise • Metrics • P95 Latency",
              "type": "metrics"
            }
          ]
        },
        "description": "BossCat enterprise views (Dashboard fallback mode)",
        "tags": [
          "enterprise",
          "cursor-startup",
          "bosscat"
        ],
        "title": "Enterprise • Saved Views (Dashboard)",
        "version": "v5"
      },
      "locked": false,
      "org_id": "0199b291-f590-7d19-a3d0-2d3254d02dda"
    },
