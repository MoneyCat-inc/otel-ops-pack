[preset00]
fRating=4.0
fGammaAdj=1.0
fDecay=0.98
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
bAdditiveWaves=1
bWaveThick=1
bModWaveAlphaByVolume=1
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bInvert=0
bMotionVectorsOn=0

fWaveAlpha=0.001
fWaveScale=1.000
fWaveSmoothing=0.600
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fWarpStrength=0.000

zoom=1.00
zoomexp=1.00
rot=0.00
cx=0.5
cy=0.5

per_frame_1=q1 = 0.50*bass + 0.30*mid + 0.20*treb;
per_frame_2=zoom = 1.00 + 0.015*sin(time*0.50) + 0.020*q1;
per_frame_3=rot = rot + 0.004*sin(time*0.25) + 0.003*(bass_att - treb_att);
per_frame_4=decay = 0.98;
per_frame_5=wave_a = 0.55;
per_frame_6=wave_r = 0.10 + 0.90*(0.20 + 0.80*sin(time*0.40));
per_frame_7=wave_g = 0.20 + 0.80*(0.50 + 0.50*sin(time*0.37+1.57));
per_frame_8=wave_b = 0.50 + 0.50*(0.70 + 0.30*sin(time*0.33+3.14));

per_pixel_1=dx = 0.002*sin(r*8.0 - time*1.2);
per_pixel_2=dy = 0.002*cos(r*8.0 - time*1.2);
per_pixel_3=rot = rot + 0.010*(r-0.5);

# Custom circular spectrum ring
wavecode_1_enabled=1
wavecode_1_samples=512
wavecode_1_bSpectrum=1
wavecode_1_sep=0
wavecode_1_thick=1
wavecode_1_additive=1
wavecode_1_smoothing=0.70
wavecode_1_r=0.00
wavecode_1_g=0.00
wavecode_1_b=0.00
wavecode_1_a=0.75
wavecode_1_base_r=0.10
wavecode_1_base_g=0.85
wavecode_1_base_b=1.00
wavecode_1_base_a=1.00
wavecode_1_param1=0.00
wavecode_1_param2=0.00
wavecode_1_param3=0.00
wavecode_1_param4=0.00
wavecode_1_x=0.5 + 0.28*cos(6.283185*sample);
wavecode_1_y=0.5 + 0.28*sin(6.283185*sample);
wavecode_1_r=0.10 + 0.90*(0.20 + 0.80*sin(time*0.40));
wavecode_1_g=0.30 + 0.70*(0.60 + 0.40*sin(time*0.37+1.20));
wavecode_1_b=1.00;
wavecode_1_a=0.50 + 0.50*(0.6 + 0.4*bass_att);

