; Resonai – VectorGrid (RN-003)
; tags: neon,grid,warp,medium,shader-free
; Style: Grid warp with spectrum line, mid-band reactive
; Safety: Moderate motion, clamped alpha, controlled warp
; Compatibility: MilkDrop 2/3, ProjectM, Butterchurn
; Author: BossCat OEM | Lane: MILK

fDecay=0.98
zoom=1.00
rot=0.00
cx=0.5
cy=0.5
dx=0.0
dy=0.0
warp=0.15

; Audio smoothing
per_frame_1 = q1 = 0.10 + 0.90*bass_att;
per_frame_2 = q2 = 0.10 + 0.90*mid_att;
per_frame_3 = q3 = 0.10 + 0.90*treb_att;
per_frame_4 = q4 = 0.85*q4 + 0.15*vol;

; Mid-band reactive motion
per_frame_5 = rot = rot + 0.010*q2;
per_frame_6 = zoom = 1.000 + 0.015*q2 + 0.008*sin(time*0.6);
per_frame_7 = warp = 0.15 + 0.10*q2;

; Purple/cyan grid palette
per_frame_8 = wave_r = 0.35 + 0.65*q3;
per_frame_9 = wave_g = 0.25 + 0.75*q2;
per_frame_10 = wave_b = 0.55 + 0.45*q1;
per_frame_11 = wave_a = 0.55 + 0.35*q4;

; Grid warp (radial + angular)
per_pixel_1 = zoom = zoom + 0.08*rad*q2;
per_pixel_2 = rot = rot + 0.04*ang*q2;

; Horizontal spectrum line
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_bSpectrum=1
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=0
wavecode_0_smoothing=0.65

wavecode_0_r=1; wavecode_0_g=1; wavecode_0_b=1; wavecode_0_a=1

wavecode_0_per_point1 = x = sample;
wavecode_0_per_point2 = y = 0.5 + 0.25*value1*q2;
wavecode_0_per_point3 = r = 0.25 + 0.75*q3;
wavecode_0_per_point4 = g = 0.20 + 0.80*q2;
wavecode_0_per_point5 = b = 0.45 + 0.55*q1;
wavecode_0_per_point6 = a = 0.60 + 0.30*value1;

