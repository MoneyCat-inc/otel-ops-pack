; TEMPLATE — BossCat Minimal (Shader-free)
; tags: neon,circle,spectrum,calm,shader-free
; Style: Subtle zoom/rot, one circular spectrum wave, neon bias
; Safety: Clamped alphas, conservative decay, smoothed audio inputs
; Compatibility: MilkDrop 2/3, ProjectM, Butterchurn
; Author: BossCat OEM | Lane: MILK | Version: 1.0

; === Global Settings ===
fDecay=0.985
zoom=1.00
rot=0.00
cx=0.5
cy=0.5
dx=0.0
dy=0.0
warp=0.0
sx=1.0
sy=1.0

; === Per-Frame (Global, once per frame) ===
; Audio smoothing via q-vars (Exponential Moving Average)
per_frame_1 = q1 = 0.10 + 0.90*bass_att;   /* bass (smoothed) */
per_frame_2 = q2 = 0.10 + 0.90*mid_att;    /* mids (smoothed) */
per_frame_3 = q3 = 0.10 + 0.90*treb_att;   /* treble (smoothed) */
per_frame_4 = q4 = 0.80*q4 + 0.20*vol;     /* volume (EMA for smoothness) */

; Motion (conservative deltas)
per_frame_5 = rot = rot + 0.006 + 0.010*(q2 - q3);
per_frame_6 = zoom = 1.000 + 0.008*q1 + 0.004*sin(time*0.5);

; Wave color (Resonai Neon palette: cyan/teal/purple)
per_frame_7 = wave_r = 0.30 + 0.70*q3;
per_frame_8 = wave_g = 0.30 + 0.70*q2;
per_frame_9 = wave_b = 0.50 + 0.50*q1;
per_frame_10 = wave_a = 0.50 + 0.40*q4;  /* clamped high to reduce strobe */

; === Per-Pixel (Spatial, vertex grid) ===
; Gentle warp based on radius
per_pixel_1 = zoom = zoom + 0.04*rad;
per_pixel_2 = rot = rot + 0.02*(rad - 0.5);

; === Custom Wave 1: Circular Spectrum Ring ===
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_bSpectrum=1
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_smoothing=0.7

; Wave color defaults
wavecode_0_r=1
wavecode_0_g=1
wavecode_0_b=1
wavecode_0_a=1

; Per-point (circular spectrum placement)
wavecode_0_per_point1 = ang  = 6.283185*sample;
wavecode_0_per_point2 = rad1 = 0.36 + 0.22*value1 + 0.06*q1;
wavecode_0_per_point3 = x = 0.5 + rad1*cos(ang + time*0.25);
wavecode_0_per_point4 = y = 0.5 + rad1*sin(ang + time*0.25);
wavecode_0_per_point5 = r = 0.10 + 0.90*q3;
wavecode_0_per_point6 = g = 0.10 + 0.90*q2;
wavecode_0_per_point7 = b = 0.20 + 0.80*q1;
wavecode_0_per_point8 = a = 0.35 + 0.65*value1;

; === Safety Notes ===
; 1. fDecay ≤ 0.99 (here: 0.985) - prevents excessive trails
; 2. wave_a ≤ 0.9 (here: 0.50 + 0.40*q4 max = 0.90) - prevents flash
; 3. Audio smoothing via *_att + EMA - gentle response
; 4. zoom/rot deltas ≤ 0.02 - stable motion
; 5. No shaders - ProjectM compatible
; 6. Spectrum smoothing 0.7 - reduces jitter

; === Customization Guide ===
; - Adjust q1-q4 EMA weights (0.80 factor = smoother, 0.50 = more reactive)
; - Change wave_r/g/b ratios for different color bias
; - Modify rad1 formula for ring size (0.36 base + audio scaling)
; - Adjust time multiplier (0.25) for rotation speed
; - Add second wave for multi-ring effect (copy wavecode_0 to wavecode_1)

