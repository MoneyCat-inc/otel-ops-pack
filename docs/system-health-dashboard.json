{
  "version": "1",
  "dashboard": {
    "id": "system-health-monolith-d",
    "title": "Monolith-D System Health Dashboard",
    "description": "Real-time monitoring of system security, device status, and application stability",
    "tags": ["system", "health", "security", "monolith-d"],
    "timeRange": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": "dma-protection-status",
        "title": "Kernel DMA Protection Status",
        "type": "stat",
        "targets": [
          {
            "expr": "count({dataset=\"system_health\", hostname=\"monolith-d\"} |= \"DMAProtection\" | json | DMAProtection = true)",
            "legendFormat": "DMA Protection Enabled"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "short",
            "min": 0,
            "max": 1
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "virtual-desktop-monitor",
        "title": "Virtual Desktop Monitor Status",
        "type": "stat",
        "targets": [
          {
            "expr": "count({dataset=\"system_health\", hostname=\"monolith-d\"} |= \"Virtual Desktop Monitor\" | json | Devices[].Status = \"OK\")",
            "legendFormat": "VD Monitor OK"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "short",
            "min": 0,
            "max": 1
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": "phone-app-stability",
        "title": "Phone App Stability",
        "type": "stat",
        "targets": [
          {
            "expr": "count({dataset=\"system_health\", hostname=\"monolith-d\"} |= \"PhoneAppRunning\" | json | ApplicationStability.PhoneAppRunning = true)",
            "legendFormat": "Phone App Running"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "yellow",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "short",
            "min": 0,
            "max": 1
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": "recent-crashes",
        "title": "Recent Crashes (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "max({dataset=\"system_health\", hostname=\"monolith-d\"} |= \"RecentCrashes\" | json | ApplicationStability.RecentCrashes)",
            "legendFormat": "Recent Crashes"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 3
                }
              ]
            },
            "unit": "short",
            "min": 0
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": "system-health-timeline",
        "title": "System Health Timeline",
        "type": "timeseries",
        "targets": [
          {
            "expr": "count({dataset=\"system_health\", hostname=\"monolith-d\"} | json | DMAProtection = true)",
            "legendFormat": "DMA Protection"
          },
          {
            "expr": "count({dataset=\"system_health\", hostname=\"monolith-d\"} | json | ApplicationStability.PhoneAppRunning = true)",
            "legendFormat": "Phone App Running"
          },
          {
            "expr": "max({dataset=\"system_health\", hostname=\"monolith-d\"} | json | ApplicationStability.RecentCrashes)",
            "legendFormat": "Recent Crashes"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 8
        }
      }
    ],
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    }
  }
}
