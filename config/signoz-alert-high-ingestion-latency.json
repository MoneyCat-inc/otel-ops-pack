{
  "duration": "5m",
  "condition": {
    "operator": ">",
    "value": 200,
    "severity": "warning"
  },
  "query": "histogram_quantile(0.95, rate(otelcol_processor_batch_batch_send_latency_bucket[5m]))",
  "enabled": true,
  "annotations": {
    "summary": "Log ingestion latency P95 exceeds 200ms",
    "description": "Alert triggered when log ingestion latency p95 exceeds 200ms"
  },
  "name": "High Ingestion Latency",
  "labels": {
    "component": "otel_collector",
    "alert_type": "performance",
    "metric": "ingestion_latency"
  },
  "description": "Log ingestion latency P95 exceeds 200ms"
}
