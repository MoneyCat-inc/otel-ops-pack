<?xml version="1.0"?>
<!--
  Bound ClickHouse's internal system.* log tables.

  Incident 2026-08-18: these tables had no TTL and accumulated 50 GiB since
  2025-10-05 (text_log 20.4 GiB at Debug/Trace level, trace_log 17.6 GiB from
  the profilers) while actual SigNoz telemetry was under 400 MiB. Their
  merges then exceeded the container's 2 GiB memory limit and failed ~98k
  times/day, each retry writing fresh ext4 blocks that permanently inflated
  docker_data.vhdx (WSL2 VHDX never shrinks on its own) until C: filled.

  On ClickHouse 25.x these logs are enabled by compiled-in defaults, so
  <table remove="remove"/> does NOT disable them (verified live: trace_log
  and asynchronous_metric_log kept writing with the element absent from the
  preprocessed config). Every table therefore gets an explicit 7-day TTL
  instead - bounded beats disabled-in-theory.

  Mounted by docker-compose.yml as /etc/clickhouse-server/config.d/system-logs.xml.
  NOTE: when TTL/settings here differ from an existing table, ClickHouse renames
  the old table with a _N suffix on startup and creates a fresh one; the renamed
  tables must be dropped manually (see docs/DOCKER_VHDX_MAINTENANCE.md).
-->
<clickhouse>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>
    <metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </metric_log>
    <trace_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </trace_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <processors_profile_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </processors_profile_log>
    <query_views_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_views_log>
    <query_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_metric_log>
    <latency_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </latency_log>
    <error_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
    <!-- Missed by the 2026-08-18 fix (table did not exist on 25.8; appeared with 25.12).
         crash_log stays unbounded on purpose - a few KiB, and it is the black box. -->
    <background_schedule_pool_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </background_schedule_pool_log>

    <!-- Was logging ~15M Debug/Trace rows per day; cut to warning 2026-08-18. Cut to fatal
         2026-09-03 because the loop recurred at warning level: every failed merge of text_log
         itself (MEMORY_LIMIT_EXCEEDED under the 2.5 GiB cap, 10-15k/hour) logged an Error row
         INTO text_log, so the one table that could not merge kept growing (~1M rows/day) and
         each retry re-allocated ~1.9 GiB. Server errors remain in `docker logs
         signoz-clickhouse`; nothing in this stack reads system.text_log. Level changes do not
         rename the table (no _N leftover) - but existing parts must be TRUNCATEd by the
         operator, since TTL needs the very merges that fail. -->
    <text_log>
        <level>fatal</level>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </text_log>

    <!-- Server-level memory profilers were the main trace_log writer (Memory/MemoryPeak
         samples). SigNoz never reads them. There are TWO knobs and the 2026-08-18 fix only
         zeroed the first:
           total_memory_tracker_sample_probability - random allocation sampling
           total_memory_profiler_step              - stack trace every N bytes of peak growth
                                                     (default 4 MiB; this is what wrote
                                                     ~45M Memory/MemoryPeak rows/day, ~2 GiB/day,
                                                     observed 2026-08-23 audit)
         Zero means disabled for both. -->
    <total_memory_tracker_sample_probability>0</total_memory_tracker_sample_probability>
    <total_memory_profiler_step>0</total_memory_profiler_step>

    <!-- ClickHouse 25.12 enables the server-wide thread profiler by default (10s period; it was
         0/off on 25.8). Observed 2026-08-24: ~127k 'Real' rows per 5 min into system.trace_log
         with query_id='' - the third profiler knob after the two above. SigNoz never reads it. -->
    <global_profiler_real_time_period_ns>0</global_profiler_real_time_period_ns>
    <global_profiler_cpu_time_period_ns>0</global_profiler_cpu_time_period_ns>
</clickhouse>
