per_frame_1=zoom = 1.00 + 0.10*bass + 0.04*mid;
per_frame_2=rot = 0.018*sin(time*0.8);
per_frame_3=wave_a = 0.35*bass_att;
per_frame_4=wave_r = 0.35 + 0.25*mid;
per_frame_5=wave_g = 0.25 + 0.35*treb;
per_frame_6=wave_b = 0.45 + 0.35*bass;
per_frame_7=cx = 0.5 + 0.03*sin(time*0.9);
per_frame_8=cy = 0.5 + 0.03*cos(time*1.1);
per_frame_9=q1 = bass;
per_frame_10=q2 = mid;

per_pixel_1=dx = 0.012*sin(3.5*ang + time*0.6);
per_pixel_2=dy = 0.012*cos(2.5*rad + time*0.5);
per_pixel_3=zoom = zoom + q1 * rad * 0.06;
per_pixel_4=ang = ang + q2 * 0.025 * (1 - rad);

