per_frame_1=wave_r = 0.59 + 0.41*sin(time*0.52);
per_frame_2=wave_g = 0.59 + 0.41*sin(time*0.73);
per_frame_3=wave_b = 0.59 + 0.41*cos(time*0.92);
per_frame_4=beat = (bass + mid + treb) * 0.33;
per_frame_5=zoom = 1.0 + 0.018*sin(time*0.85) + 0.024*beat;
per_frame_6=rot = 0.011*sin(time*0.27);
per_frame_7=cx = 0.5 + 0.042*sin(time*0.36);
per_frame_8=cy = 0.5 + 0.042*cos(time*0.32);
per_frame_9=q1 = beat;

per_pixel_1=dx = 0.008*sin(2*ang + time*0.45);
per_pixel_2=dy = 0.008*cos(2*rad + time*0.38);
per_pixel_3=zoom = zoom + q1 * 0.032 * rad;

