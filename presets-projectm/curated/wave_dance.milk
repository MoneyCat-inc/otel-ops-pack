per_frame_1=wave_r = 0.68 + 0.32*sin(time*1.3);
per_frame_2=wave_g = 0.68 + 0.32*sin(time*1.6);
per_frame_3=wave_b = 0.68 + 0.32*cos(time*1.4);
per_frame_4=beat = (bass + mid + treb) * 0.33;
per_frame_5=zoom = 1.0 + 0.035*sin(time*0.65) + 0.045*beat;
per_frame_6=rot = 0.028*sin(time*0.38);
per_frame_7=cx = 0.5 + 0.07*sin(time*0.48);
per_frame_8=cy = 0.5 + 0.07*cos(time*0.42);
per_frame_9=q1 = beat;

per_pixel_1=zoom = zoom + rad * 0.085 * sin(time*1.05);
per_pixel_2=ang = ang + q1 * 0.028 * (1 - rad);

