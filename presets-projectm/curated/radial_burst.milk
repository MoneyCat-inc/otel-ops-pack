per_frame_1=wave_r = 0.52 + 0.48*sin(time*0.8);
per_frame_2=wave_g = 0.52 + 0.48*sin(time*1.0);
per_frame_3=wave_b = 0.52 + 0.48*cos(time*1.2);
per_frame_4=beat = (bass + mid + treb) * 0.33;
per_frame_5=zoom = 1.0 + 0.05*sin(time*0.6);
per_frame_6=rot = 0.015*sin(time*0.3);
per_frame_7=cx = 0.5;
per_frame_8=cy = 0.5;
per_frame_9=q1 = beat;

per_pixel_1=zoom = zoom + rad * 0.12 * sin(rad*6.28 + time*1.5);
per_pixel_2=ang = ang + q1 * 0.015 * rad;

