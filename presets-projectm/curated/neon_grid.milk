per_frame_1=wave_r = 0.75 + 0.25*sin(time*1.8);
per_frame_2=wave_g = 0.75 + 0.25*sin(time*2.2);
per_frame_3=wave_b = 0.75 + 0.25*cos(time*1.6);
per_frame_4=beat = (bass + mid + treb) * 0.33;
per_frame_5=zoom = 1.0 + 0.032*sin(time*0.62) + 0.042*beat;
per_frame_6=rot = 0.022*sin(time*0.36);
per_frame_7=cx = 0.5 + 0.058*sin(time*0.52);
per_frame_8=cy = 0.5 + 0.058*cos(time*0.46);
per_frame_9=q1 = beat;

per_pixel_1=zoom = zoom + rad * 0.075 * sin(time*1.08);
per_pixel_2=ang = ang + q1 * 0.026 * (1 - rad);

