per_frame_1=zoom = 1.00 + 0.05*bass + 0.025*mid;
per_frame_2=rot = 0.04*sin(time*0.75) + 0.035*bass;
per_frame_3=wave_a = 0.45*bass_att;
per_frame_4=wave_r = 0.38 + 0.28*mid;
per_frame_5=wave_g = 0.28 + 0.38*treb;
per_frame_6=wave_b = 0.48 + 0.32*bass;
per_frame_7=cx = 0.5 + 0.035*sin(time*0.85);
per_frame_8=cy = 0.5 + 0.035*cos(time*1.05);
per_frame_9=q1 = bass;
per_frame_10=q2 = mid;

per_pixel_1=ang = ang + 0.18 * sin(rad*2*3.14 + time*0.95);
per_pixel_2=zoom = zoom + q1 * 0.055 * rad;
per_pixel_3=dx = 0.014*sin(4.5*ang + time*0.65);
per_pixel_4=dy = 0.014*cos(3.5*rad + time*0.55);

