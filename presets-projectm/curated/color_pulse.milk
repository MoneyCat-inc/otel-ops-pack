per_frame_1=wave_r = 0.7 + 0.3*sin(time*1.5);
per_frame_2=wave_g = 0.7 + 0.3*sin(time*2.1);
per_frame_3=wave_b = 0.7 + 0.3*cos(time*1.7);
per_frame_4=beat = (bass + mid + treb) * 0.33;
per_frame_5=zoom = 1.0 + 0.025*sin(time*0.6) + 0.035*beat;
per_frame_6=rot = 0.025*sin(time*0.35);
per_frame_7=cx = 0.5 + 0.06*sin(time*0.5);
per_frame_8=cy = 0.5 + 0.06*cos(time*0.4);
per_frame_9=q1 = beat;

per_pixel_1=zoom = zoom + rad * 0.07 * sin(time*1.1);
per_pixel_2=ang = ang + q1 * 0.025 * (1 - rad);

