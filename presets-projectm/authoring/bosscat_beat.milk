; Gate #012 - BossCat Beat-Reactive Preset
; ECRR: Minimal bass-driven warp to verify visual + audio integration
; Authority: BossCat OEM

[preset00]
fDecay=0.95
fVideoEchoZoom=1.5
fVideoEchoAlpha=0.40
fWaveAlpha=0.80
bAdditiveWaves=1
bTexWrap=1

per_frame_1=zoom = 1.00 + 0.03*sin(time*2.0) + 0.05*bass_att;
per_frame_2=rot  = 0.02*sin(time*0.7) + 0.05*bass;

per_pixel_1=dx = 0.02*sin(ang*6.283 + time*0.9) * bass;
per_pixel_2=dy = 0.02*cos(rad*3.1415 + time*0.4) * mid;

; waves help avoid blackout + raise motion energy
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_thick=1
wavecode_0_additive=1
wavecode_0_bSpectrum=1
wavecode_0_scaling=1.0
wavecode_0_a=0.6

