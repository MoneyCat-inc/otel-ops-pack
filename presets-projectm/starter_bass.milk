per_frame_1=zoom = 1.00 + 0.08*bass + 0.03*mid;
per_frame_2=rot = 0.015*sin(time*0.7);
per_frame_3=wave_a = 0.4*bass_att;
per_frame_4=wave_r = 0.3 + 0.2*mid;
per_frame_5=wave_g = 0.2 + 0.3*treb;
per_frame_6=wave_b = 0.4 + 0.3*bass;
per_frame_7=cx = 0.5 + 0.02*sin(time*0.9);
per_frame_8=cy = 0.5 + 0.02*cos(time*1.1);
per_frame_9=q1 = bass;
per_frame_10=q2 = mid;

per_pixel_1=dx = 0.01*sin(3*ang + time*0.5);
per_pixel_2=dy = 0.01*cos(2*rad + time*0.4);
per_pixel_3=zoom = zoom + q1 * rad * 0.05;
per_pixel_4=ang = ang + q2 * 0.02 * (1 - rad);

