per_frame_1=wave_r = 0.5 + 0.5*sin(time*0.7);
per_frame_2=wave_g = 0.5 + 0.5*sin(time*0.9);
per_frame_3=wave_b = 0.5 + 0.5*cos(time*1.1);
per_frame_4=beat = (bass + mid + treb) * 0.33;
per_frame_5=zoom = 1.0 + 0.02*sin(time*0.7) + 0.03*beat;
per_frame_6=rot = 0.02*sin(time*0.31);
per_frame_7=cx = 0.5 + 0.1*sin(time*0.43);
per_frame_8=cy = 0.5 + 0.1*cos(time*0.37);
per_frame_9=q1 = beat;

per_pixel_1=zoom = zoom + rad * 0.08 * sin(time*0.9);
per_pixel_2=ang = ang + q1 * 0.02 * (1 - rad);


