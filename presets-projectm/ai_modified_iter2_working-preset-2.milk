shape_2_per_frame1=cols = 10;
shape_2_per_frame2=col = instance - floor(instance/cols)*cols;
shape_2_per_frame3=row = floor(instance/cols);
shape_2_per_frame4=digit_idx = floor(col/5);
shape_2_per_frame5=digit_col = col - digit_idx*5;
shape_2_per_frame6=digit = if(equal(digit_idx,0), q26, q27);
shape_2_per_frame7=base_x = q29 + digit_idx*0.06;
shape_2_per_frame8=x = base_x + (digit_col + 0.5)*0.008;
shape_2_per_frame9=y = q30 - (row + 0.5)*0.012;
shape_2_per_frame10=rad = 0.0035;
shape_2_per_frame11=top = equal(row,0);
shape_2_per_frame12=bottom = equal(row,6);
shape_2_per_frame13=middle = equal(row,3);
shape_2_per_frame14=upper = below(row,3);
shape_2_per_frame15=lower = above(row,3);
shape_2_per_frame16=left = equal(digit_col,0);
shape_2_per_frame17=right = equal(digit_col,4);
shape_2_per_frame18=inner_left = equal(digit_col,1);
shape_2_per_frame19=inner_right = equal(digit_col,3);
shape_2_per_frame20=on = 0;
shape_2_per_frame21=cond0 = if(equal(digit,0), max(max(top, bottom), max(left, right)), 0);
shape_2_per_frame22=cond1 = if(equal(digit,1), max(inner_right, right), 0);
shape_2_per_frame23=cond2 = if(equal(digit,2), max(max(top, bottom), max(middle, max(right*upper, left*lower))), 0);
shape_2_per_frame24=cond3 = if(equal(digit,3), max(max(top, bottom), max(middle, right)), 0);
shape_2_per_frame25=cond4 = if(equal(digit,4), max(middle, max(right, left*upper)), 0);
shape_2_per_frame26=cond5 = if(equal(digit,5), max(max(top, bottom), max(middle, max(left*upper, right*lower))), 0);
shape_2_per_frame27=cond6 = if(equal(digit,6), max(max(bottom, middle), max(left, max(top, right*lower))), 0);
shape_2_per_frame28=cond7 = if(equal(digit,7), max(top, max(right, inner_right)), 0);
shape_2_per_frame29=cond8 = if(equal(digit,8), max(max(top, bottom), max(middle, max(left, right))), 0);
shape_2_per_frame30=cond9 = if(equal(digit,9), max(max(top, bottom), max(middle, max(right, left*upper))), 0);
shape_2_per_frame31=on = max(on, cond0);
shape_2_per_frame32=on = max(on, cond1);
shape_2_per_frame33=on = max(on, cond2);
shape_2_per_frame34=on = max(on, cond3);
shape_2_per_frame35=on = max(on, cond4);
shape_2_per_frame36=on = max(on, cond5);
shape_2_per_frame37=on = max(on, cond6);
shape_2_per_frame38=on = max(on, cond7);
shape_2_per_frame39=on = max(on, cond8);
shape_2_per_frame40=on = max(on, cond9);
shape_2_per_frame41=a = on * 0.95;
shape_2_per_frame42=a2 = a;

