shape_0_per_frame1=seg = q25 / num_inst;
shape_0_per_frame2=fill = min(q23, num_inst);
shape_0_per_frame3=x = q24 + (instance + 0.5) * seg;
shape_0_per_frame4=y = q30;
shape_0_per_frame5=rad = seg * 0.45;
shape_0_per_frame6=a = if(below(instance, fill), 0.95, 0.2);
shape_0_per_frame7=a2 = a;
shape_0_per_frame8=r = 1;
shape_0_per_frame9=g = 0.9;
shape_0_per_frame10=b = 0.1;
