shape_1_per_frame1=cols = 10;
shape_1_per_frame2=col = instance - floor(instance/cols)*cols;
shape_1_per_frame3=row = floor(instance/cols);
shape_1_per_frame4=char_idx = floor(col/5);
shape_1_per_frame5=char_col = col - char_idx*5;
shape_1_per_frame6=label_base = (q24 - 0.07) + char_idx*0.06;
shape_1_per_frame7=x = label_base + (char_col + 0.5)*0.008;
shape_1_per_frame8=y = q30 - (row + 0.5)*0.012;
shape_1_per_frame9=on = 0;
shape_1_per_frame10=condT = if(equal(char_idx, 0), max(equal(row, 0), equal(char_col, 2)), 0);
shape_1_per_frame11=condS = if(equal(char_idx, 1), max(max(equal(row, 0), equal(row, 3)), max(equal(row, 6), max(equal(char_col, 0)*below(row,3), equal(char_col,4)*above(row,3)))), 0);
shape_1_per_frame12=on = max(max(on, condT), condS);
shape_1_per_frame13=a = on * 0.75;
shape_1_per_frame14=a2 = a;

shapecode_2_enabled=1
