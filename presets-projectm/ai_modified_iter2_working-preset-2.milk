per_frame_1=wave_r = 0.5 + 0.5*sin(time*0.7);
per_frame_2=wave_g = 0.5 + 0.5*sin(time*0.9);
per_frame_3=wave_b = 0.5 + 0.5*cos(time*1.1);
per_frame_4=beat = (bass + mid + treb) * 0.33;
per_frame_5=zoom = 1.0 + 0.02*sin(time*0.7) + 0.03*beat;
per_frame_6=rot = 0.02*sin(time*0.31);
per_frame_7=cx = 0.5 + 0.1*sin(time*0.43);
per_frame_8=cy = 0.5 + 0.1*cos(time*0.37);
per_frame_9=q1 = beat;
per_frame_10=prev_time = q20;
per_frame_11=q20 = time;
per_frame_12=dt = time - prev_time;
per_frame_13=dt = if(below(dt, 0), 0, dt);
per_frame_14=ts_raw = dt * fps;
per_frame_15=q21 = 0.85*q21 + 0.15*ts_raw;
per_frame_16=q22 = min(max(q21, 0), 4);
per_frame_17=q23 = min(q22 * 60, 60);
per_frame_18=q24 = 0.06;
per_frame_19=q25 = 0.32;
per_frame_20=int_part = floor(q22);
per_frame_21=q26 = min(max(int_part, 0), 9);
per_frame_22=frac_val = q22 - q26;
per_frame_23=tenths = floor(frac_val*10 + 0.5);
per_frame_24=q27 = min(max(tenths, 0), 9);
per_frame_25=q29 = q24 + q25 + 0.045;
per_frame_26=q30 = 0.94;

per_pixel_1=zoom = zoom + rad * 0.08 * sin(time*0.9);
per_pixel_2=ang = ang + q1 * 0.02 * (1 - rad);

shapecode_0_enabled=1
