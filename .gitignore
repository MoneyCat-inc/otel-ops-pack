# BossCat guardrails - ephemeral/build outputs (use DELT/ARTF/ for evidence)
# Default: ignore artifacts
artifacts/**
# ICF artifacts: keep live baseline + archived demos
!artifacts/icf/
artifacts/icf/*
!artifacts/icf/rollup.json
!artifacts/icf/rollup.demo-*.json
# ECRR evidence under artifacts remains untracked
artifacts/ecrr/**

# Runtime/vendor dirs
node_modules/**

# Local secrets (never commit)
BRAV/SCPT/secrets/**

# Forbidden legacy roots - migrated to tetragram structure
config/
configs/
tests/
schemas/
triton-models/

# GPU metric buffers (ephemeral)
DELT/ARTF/gpu-buffers/**

# MILK Lane vendor bundles (minified, security-scanned separately)
docs/BossCat/visuals/vendor/

# SOCM Credentials (Bluesky App Passwords)
.env.socm
.env.social
*.env.local

# Ephemeral logs
*.last.log
logs/
logs/**/*.last.log
*.docx
*.pdf
# Backup artifacts (generated by remediation scripts)
**/*.backup-*

# SigNoz / local secrets
.env
.env.local
.env.*.local
signoz.env
secrets/
# Next.js build output
out/

# --- Phase 4: Binary Bloat & Debug Script Guard (Gate #030 Disposition) ---
# Authority: BossCat OEM (Fubumaki) | Executor: Cursor{Implementer}
# Date: 2025-10-27 | Protects repo from 395+ binary artifacts

# .NET build outputs (Gate #026-029 services)
bosscat-svc*/bin/
bosscat-svc*/obj/
dotnet-test-app/bin/
dotnet-test-app/obj/
dotnet-autoinstrumentation/

# Debug scripts (quarantined - not for production)
debug-*.ps1
test-api-proof.ps1
test-signoz-api.ps1
scripts/dev/

# Keep textual evidence artifacts only
artifacts/**/*
!artifacts/**/*.md
!artifacts/**/*.txt
!artifacts/**/*.json
!artifacts/**/*.csv
!artifacts/.manifest/

# Allow curated screenshots (managed via Phase 1 curation)
!artifacts/gate026/*.png

# Block bulk binaries and temp files
artifacts/**/*.zip
artifacts/**/*.7z
artifacts/**/*.gz
artifacts/**/*.bin
artifacts/**/tmp/

# Cleanup - Added 2025-11-01
tmp_*/
.next/
out/
artifacts/**/manifest.json
artifacts/**/request.json
snap_*.jpg
test-*.jpg
