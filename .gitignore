# Ignore backup and temporary files
*.bak.*
*.last.*
*.zip
*.sha256

# Ignore operational directories (keep structure but ignore contents)
logs/
audit/
backup/
state/

# Ignore Windows-specific files
Thumbs.db
Desktop.ini

# Ignore PowerShell profile and temporary files
*.ps1.bak
*.ps1.tmp

# Ignore any IDE files
.vscode/
.idea/
*.swp
*.swo
