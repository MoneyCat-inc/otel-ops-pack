# OpenTelemetry Agent Configuration
# Copy this file to .env and adjust values as needed

# Enable/disable OpenTelemetry instrumentation
OTEL_ENABLED=1

# OpenTelemetry collector endpoint (HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name for telemetry
OTEL_SERVICE_NAME=resonai-agent

# Environment (development, staging, production)
NODE_ENV=development

# Agent-specific configuration
AGENT_MAX_JOBS=3
AGENT_MAX_FILES=15
AGENT_MAX_LINES=500
AGENT_JOB_TTL_SECONDS=86400

# Flake quarantine thresholds
FLAKE_THRESHOLD=0.3
FLAKE_MIN_RUNS=5

# Logging configuration
LOG_LEVEL=info
LOG_TO_FILE=true

# Performance settings
AGENT_TIMEOUT_SECONDS=60
AGENT_MEMORY_LIMIT_MB=512
AGENT_PARALLEL_JOBS=2

# Notification settings
HEALTH_CHECK_FAILURES=true
JOB_COMPLETION=false
ERROR_ALERTS=true
