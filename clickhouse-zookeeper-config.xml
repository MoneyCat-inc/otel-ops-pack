<?xml version="1.0"?>
<clickhouse>
    <zookeeper>
        <node>
            <host>signoz-zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>
    
    <!-- ZooKeeper session timeout -->
    <zookeeper_session_timeout_ms>30000</zookeeper_session_timeout_ms>
    
    <!-- Enable ZooKeeper for distributed DDL -->
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
    
    <!-- Replication settings -->
    <replication>
        <zookeeper_path>/clickhouse/tables/</zookeeper_path>
    </replication>
</clickhouse>