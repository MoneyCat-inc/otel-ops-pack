FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package.json ./
RUN apk add --no-cache wget

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy application code
COPY otel-demo-app.js ./

# Set OpenTelemetry environment variables
ENV OTEL_SERVICE_NAME=otel-demo-app
ENV OTEL_SERVICE_VERSION=1.0.0
ENV OTEL_RESOURCE_ATTRIBUTES="service.name=otel-demo-app,service.version=1.0.0,deployment.environment=production"

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/health || exit 1

# Start the application with OpenTelemetry auto-instrumentation
CMD ["node", "--require", "@opentelemetry/auto-instrumentations-node/register", "otel-demo-app.js"]
