{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@alfa/*": ["ALFA/*"],
      "@alfa/test/*": ["ALFA/TEST/*"],
      "@alfa/tool/*": ["ALFA/TOOL/*"],
      "@alfa/otel/*": ["ALFA/OTEL/*"],
      "@alfa/apps/*": ["ALFA/APPS/*"],
      "@alfa/libs/*": ["ALFA/LIBS/*"],
      "@alfa/core/*": ["ALFA/CORE/*"],
      "@brav/*": ["BRAV/*"],
      "@brav/scpt/*": ["BRAV/SCPT/*"],
      "@brav/infr/*": ["BRAV/INFR/*"],
      "@brav/dock/*": ["BRAV/DOCK/*"],
      "@char/*": ["CHAR/*"],
      "@char/docs/*": ["CHAR/DOCS/*"],
      "@char/evid/*": ["CHAR/EVID/*"],
      "@delt/*": ["DELT/*"],
      "@delt/conf/*": ["DELT/CONF/*"],
      "@delt/fixt/*": ["DELT/FIXT/*"],
      "@delt/asst/*": ["DELT/ASST/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "coverage"
  ]
}

