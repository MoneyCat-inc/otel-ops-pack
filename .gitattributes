# Git attributes for consistent line endings
# https://git-scm.com/docs/gitattributes

# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare files that should always be LF
*.sh text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf

# Declare files that are binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
