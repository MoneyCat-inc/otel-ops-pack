{
  "name": "Hurst Exponent Drift Alert",
  "description": "Detects significant drift in Hurst exponent values from fractal pattern analysis. Indicates potential changes in system behavior patterns - persistence (H>0.7), anti-persistence (H<0.3), or deviation from expected random walk behavior (H≈0.5).",
  "severity": "warning",
  "labels": {
    "service": "fractal-analysis",
    "component": "hurst-exponent",
    "severity": "warning",
    "environment": "local",
    "framework": "ecrr",
    "metric_type": "fractal_drift"
  },
  "query": {
    "queryType": "logs",
    "logsQuery": {
      "query": "message contains \"hurst_estimate\" AND log.file.path contains \"canary-pattern-results.json\"",
      "groupBy": ["pattern"],
      "legendFormat": "{{pattern}} Pattern Hurst Drift"
    }
  },
  "condition": {
    "threshold": 0.7,
    "operator": "above",
    "evaluationWindow": "15m",
    "alertFrequency": "5m",
    "notificationOnMissingData": false,
    "minimumDataPoints": 3
  },
  "notificationChannels": [
    "email-default",
    "slack-default"
  ],
  "alertDetails": {
    "expected_values": {
      "steady": 0.5,
      "poisson": 0.5,
      "pareto": ">0.5"
    },
    "drift_thresholds": {
      "persistence": 0.7,
      "anti_persistence": 0.3,
      "significant_deviation": 0.2
    },
    "interpretation": {
      "H < 0.3": "Anti-persistent behavior (mean-reverting)",
      "H ≈ 0.5": "Random walk behavior (expected for memoryless processes)",
      "H > 0.7": "Persistent behavior (long-range dependence)",
      "H > 0.8": "Strong persistence (potential system instability)"
    }
  }
}
