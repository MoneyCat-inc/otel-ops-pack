{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    // Second Pass Q5 (2026-08-15): baseUrl still required for @/* path aliases;
    // pin until imports migrate off baseUrl (TS5101 → hard error in TS 7.0).
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/scripts/*": [
        "BRAV/SCPT/*"
      ],
      "@/*": [
        "ALFA/LIBS/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "instrumentation.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "ALFA/LIBS/**/*.ts",
    "ALFA/LIBS/**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "ALFA/LIBS/prisma/prisma.config.ts",
    "ALFA/LIBS/prisma/seed.ts"
  ]
}
