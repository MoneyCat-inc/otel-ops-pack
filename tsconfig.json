{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/scripts/*": [
        "./BRAV/SCPT/*"
      ],
      "@/*": [
        "./ALFA/LIBS/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "instrumentation.ts",
    "ALFA/APPS/app/**/*.ts",
    "ALFA/APPS/app/**/*.tsx",
    "ALFA/LIBS/**/*.ts",
    "ALFA/LIBS/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "ALFA/LIBS/prisma/prisma.config.ts",
    "ALFA/LIBS/prisma/seed.ts"
  ]
}
