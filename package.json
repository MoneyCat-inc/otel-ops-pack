{
  "name": "resonai-backend",
  "version": "1.0.0",
  "description": "Resonai Backend - Local-first, consent-first architecture",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest tests/contract",
    "test:privacy": "jest tests/privacy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run test:contract && npm run test:privacy",
    "privacy-audit": "jest tests/privacy --verbose",
    "otel:setup": "node scripts/setup-otel.js",
    "memx:snapshot": "pwsh scripts/memx/snapshot.ps1",
    "memx:export": "next dev & wait-on http://localhost:3000 && echo ready",
    "memx:health": "curl http://localhost:3000/api/memx/health",
    "agent:test": "jest scripts/agent/db.test.ts",
    "agent:migrate": "tsx scripts/agent/migrate/from-json.ts",
    "agent:status": "tsx scripts/agent/status.ts",
    "agent:test-sqlite": "tsx scripts/agent/test-sqlite.ts",
    "agent:runner": "tsx scripts/agent/runner.ts",
    "agent:test-runner": "tsx scripts/agent/test-runner.ts",
    "agent:verify": "tsx scripts/agent/verify-shadow-canonical.ts",
    "agent:flip": "tsx scripts/agent/flip-shadow-canonical.ts",
    "agent:start": "tsx scripts/agent/production-agent-system.ts start",
    "agent:stop": "tsx scripts/agent/production-agent-system.ts stop",
    "agent:status-system": "tsx scripts/agent/production-agent-system.ts status",
    "agent:health": "tsx scripts/agent/production-agent-system.ts health",
    "agent:report": "tsx scripts/agent/production-agent-system.ts report",
    "agent:add-task": "tsx scripts/agent/production-agent-system.ts add-task",
    "agent:add-realtime": "tsx scripts/agent/production-agent-system.ts add-realtime",
    "agent:orchestrator": "tsx scripts/agent/orchestrator.ts",
    "agent:queue": "tsx scripts/agent/sqlite-queue.ts",
    "agent:compliance": "tsx scripts/agent/ecrr-compliance.ts",
    "agent:deploy": "tsx scripts/agent/deploy.ts",
    "agent:rollback": "tsx scripts/agent/rollback.ts",
    "roadmap:examine": "tsx scripts/roadmap/examine.ts",
    "roadmap:clean": "tsx scripts/roadmap/clean.ts",
    "roadmap:report": "tsx scripts/roadmap/report.ts",
    "roadmap:update": "tsx scripts/roadmap/index.ts",
    "ci:roadmap": "pnpm test:pr && pnpm test:nightly && pnpm roadmap:update",
    "test:isolation-offline": "playwright test tests/isolation_offline.spec.ts",
    "test:pr": "playwright test -c playwright.noweb.config.ts --grep \"@(smoke|pilot-core|a11y-smoke|security)\"",
    "test:nightly": "playwright test -c playwright.config.ts --grep \"@(dashboard|cohort-.*|data-control|prosody|strain|offline|polish|future)\" --max-failures=20",
    "test:all": "playwright test -c playwright.config.ts",
    "test:smoke": "playwright test -c playwright.noweb.config.ts --grep \"@smoke\"",
    "test:pilot": "playwright test -c playwright.noweb.config.ts --grep \"@pilot-core\"",
    "test:a11y": "playwright test -c playwright.noweb.config.ts --grep \"@a11y-smoke\"",
    "test:security": "playwright test -c playwright.noweb.config.ts --grep \"@security\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.64.1",
    "@opentelemetry/exporter-jaeger": "^1.18.1",
    "@opentelemetry/exporter-otlp-http": "^0.26.0",
    "@opentelemetry/instrumentation": "^0.45.0",
    "@opentelemetry/instrumentation-fs": "^0.11.0",
    "@opentelemetry/instrumentation-http": "^0.45.0",
    "@opentelemetry/resources": "^1.18.1",
    "@opentelemetry/sdk-node": "^0.45.1",
    "@opentelemetry/semantic-conventions": "^1.18.1",
    "@prisma/client": "^5.7.1",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.4",
    "@vercel/otel": "^2.0.1",
    "better-sqlite3": "^9.2.2",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jszip": "^3.10.1",
    "playwright": "^1.40.0",
    "prisma": "^5.7.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "app/**/*.ts",
      "lib/**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "keywords": [
    "resonai",
    "backend",
    "privacy",
    "local-first",
    "consent",
    "observability",
    "opentelemetry"
  ],
  "author": "Resonai Team",
  "license": "MIT"
}