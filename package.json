{
  "name": "resonai-backend",
  "version": "1.0.0",
  "description": "Resonai Backend - Next.js Application with OpenTelemetry",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "emit": "node scripts/emit-synthetic-span.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "security:scan": "pwsh -File scripts/monthly-trivy-scan.ps1",
    "security:scan:export": "pwsh -File scripts/monthly-trivy-scan.ps1 -ExportReport",
    "security:monitor": "pwsh -File scripts/security-monitor.ps1",
    "security:cleanup": "pwsh -File scripts/security-cleanup.ps1",
    "security:cleanup:dry": "pwsh -File scripts/security-cleanup.ps1 -DryRun",
    "dashboard:export": "pwsh -File scripts/playwright-dashboard-export.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.901.0",
    "@opentelemetry/auto-instrumentations-node": "^0.64.6",
    "@opentelemetry/core": "^2.1.0",
    "@opentelemetry/exporter-otlp-http": "^0.26.0",
    "@opentelemetry/instrumentation-document-load": "^0.51.2",
    "@opentelemetry/instrumentation-fetch": "^0.206.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.51.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.206.0",
    "@opentelemetry/sdk-trace-web": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@prisma/client": "^5.7.1",
    "@types/sqlite3": "^3.1.11",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sqlite3": "^5.1.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.206.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.206.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "jszip": "^3.10.1",
    "playwright": "^1.56.0",
    "prisma": "^5.7.1",
    "tsx": "^4.6.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nextjs",
    "prisma",
    "opentelemetry",
    "observability",
    "signoz"
  ],
  "author": "Resonai",
  "license": "MIT"
}
