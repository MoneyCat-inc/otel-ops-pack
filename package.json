{
  "name": "otel-observability-kit",
  "version": "1.0.0",
  "description": "Windows OTel to SigNoz observability pipeline with ECRR methodology",
  "scripts": {
    "pr:new": "node scripts/new-pr.mjs",
    "ecrr:template": "node scripts/ensure-pr-template.mjs",
    "ecrr:drill": "pwsh -File scripts/ecrr-failure-drill.ps1",
    "canary:status": "Get-ScheduledTask -TaskName 'OTel-ECRR-Canary' | Get-ScheduledTaskInfo",
    "canary:report": "Get-Content artifacts/canary-ecrr-report.txt -Tail 10",
    "hygiene": "pwsh ./tools/hygiene.ps1",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:smoke:ci": "playwright test -c playwright.smoke.config.ts --reporter=list",
    "tidy": "pwsh -File scripts/quick-tidy.ps1",
    "clean:deep": "pwsh -File scripts/deep-clean.ps1",
    "lint": "eslint . --ext .js,.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest -w 1",
    "quality": "npm run lint && npm run typecheck || true",
    "monitor:quick": "pwsh -File scripts/quick-monitor.ps1",
    "monitor:full": "pwsh -File scripts/monitor-optimized-pipeline.ps1",
    "monitor:export": "pwsh -File scripts/monitor-optimized-pipeline.ps1 -ExportReport",
    "monitor:sleek": "pwsh -File scripts/monitor-sleek.ps1",
    "monitor:sleek-continuous": "pwsh -File scripts/monitor-sleek.ps1 -Continuous",
    "monitor:sleek-export": "pwsh -File scripts/monitor-sleek.ps1 -ExportReport",
    "preview:dev": "cd preview && npm run dev",
    "preview:serve": "cd preview && npm run serve",
    "preview:build": "cd preview && npm run build",
    "comfort:sync": "pwsh -File scripts/scaffold-comfort-cat.ps1 -Force",
    "comfort:check": "pwsh -File scripts/comfort-checklist.ps1",
    "comfort:scaffold": "pwsh -File scripts/scaffold-comfort-cat.ps1",
    "comfort:sanity": "pwsh -File scripts/comfort-cat-sanity-sweep.ps1",
    "setup-local": "pwsh -File scripts/agent/setup-local.ps1",
    "agent:doctor": "pwsh -File scripts/agent/doctor.ps1",
    "agent:start": "pwsh -File scripts/agent/watchdog.ps1",
    "agent:demo": "pwsh -File scripts/agent/demo.ps1",
    "agent:demo-enhanced": "pwsh -File scripts/agent/demo-enhanced.ps1",
    "agent:guardrails": "pwsh -File scripts/agent/enforce-guardrails-hardened.ps1",
    "agent:watchdog-otel": "ts-node scripts/agent/watchdog.ts",
    "agent:start-enhanced": "pwsh -File scripts/agent/watchdog-enhanced.ps1",
    "agent:status": "pwsh -File scripts/agent/status-check.ps1",
    "agent:status-continuous": "pwsh -File scripts/agent/status-check.ps1 -Continuous",
    "agent:demo-premium": "pwsh -File scripts/agent/demo-premium.ps1",
    "agent:guardrails-premium": "pwsh -File scripts/agent/enforce-guardrails-premium.ps1",
    "agent:status-premium": "pwsh -File scripts/agent/status-premium.ps1",
    "agent:status-premium-continuous": "pwsh -File scripts/agent/status-premium.ps1 -Continuous",
    "agent:smoke-test": "pwsh -File scripts/agent/smoke-test.ps1",
    "agent:smoke-test-all": "pwsh -File scripts/agent/smoke-test.ps1 -All",
    "agent:status-badge": "pwsh -File scripts/agent/status-badge.ps1",
    "agent:status-badge-json": "pwsh -File scripts/agent/status-badge.ps1 -Json",
    "agent:pre-commit": "pwsh -File scripts/agent/pre-commit-hook.ps1",
    "agent:pr-badge": "pwsh -File scripts/agent/pr-badge-check.ps1",
    "agent:pr-badge-check": "pwsh -File scripts/agent/pr-badge-check.ps1 -CheckOnly",
    "agent:pr-badge-update": "pwsh -File scripts/agent/pr-badge-check.ps1 -UpdateTemplate",
    "agent:nightly-chaos": "pwsh -File scripts/agent/nightly-chaos.ps1",
    "agent:nightly-chaos-archive": "pwsh -File scripts/agent/nightly-chaos.ps1 -Archive",
    "agent:doc-refresh": "pwsh -File scripts/agent/doc-auto-refresh.ps1",
    "agent:doc-refresh-backup": "pwsh -File scripts/agent/doc-auto-refresh.ps1 -Backup",
    "agent:telemetry": "pwsh -File scripts/agent/synthetic-telemetry.ps1",
    "agent:telemetry-dry": "pwsh -File scripts/agent/synthetic-telemetry.ps1 -DryRun",
    "agent:drill-recover": "pwsh -File scripts/agent/drill-recover.ps1",
    "agent:pr-badge-json": "pwsh -File scripts/agent/pr-badge-check.ps1 -Json",
    "agent:test-determinism": "pwsh -File scripts/agent/utils/determinism.ps1",
    "agent:test-concurrency": "pwsh -File scripts/agent/utils/concurrency.ps1",
    "agent:test-secrets": "pwsh -File scripts/agent/utils/secrets-hygiene.ps1",
    "agent:generate-sbom": "pwsh -File scripts/agent/generate-sbom.ps1",
    "agent:service-install": "pwsh -File scripts/agent/service-install.ps1",
    "agent:service-uninstall": "pwsh -File scripts/agent/service-uninstall.ps1",
    "agent:policy-check": "pwsh -File scripts/agent/policy-check.ps1",
    "agent:policy-check-json": "pwsh -File scripts/agent/policy-check.ps1 -Json",
    "agent:status-fleet": "pwsh -File scripts/agent/status-fleet.ps1",
    "agent:status-fleet-json": "pwsh -File scripts/agent/status-fleet.ps1 -Json",
    "agent:cutover-validate": "pwsh -File scripts/agent/cutover-validation.ps1",
    "agent:cutover-validate-json": "pwsh -File scripts/agent/cutover-validation.ps1 json-purity",
    "agent:cutover-validate-killswitch": "pwsh -File scripts/agent/cutover-validation.ps1 kill-switch",
    "agent:cutover-validate-policy": "pwsh -File scripts/agent/cutover-validation.ps1 policy-gate",
    "agent:cutover-validate-service": "pwsh -File scripts/agent/cutover-validation.ps1 service-health",
    "agent:status-fleet-ps": "pwsh -File scripts/agent/status-fleet.ps1 -Json",
    "agent:status-fleet-sh": "bash scripts/agent/status-fleet.sh ..",
    "policy:build": "pwsh -File scripts/policy/build-bundle.ps1",
    "policy:sign": "pwsh -File scripts/policy/sign-bundle.ps1",
    "policy:verify": "pwsh -File scripts/policy/verify-bundle.ps1",
    "sbom:gen": "pwsh -File scripts/supplychain/generate-sbom.ps1",
    "sbom:sign": "pwsh -File scripts/supplychain/sign-sbom.ps1",
    "docker:watchdog:build": "docker build -f docker/Dockerfile.watchdog -t codex-local:watchdog .",
    "helm:lint": "helm lint helm/codex-local",
    "agent:auto-pr": "pwsh -File scripts/agent/auto-pr.ps1",
    "cursor:start": "pwsh -File scripts/agent/cursor-gap-closer.ps1",
    "cursor:status": "pwsh -File scripts/agent/cursor-gap-closer.ps1 -Status",
    "cursor:stop": "pwsh -File scripts/agent/cursor-gap-closer.ps1 -Stop",
    "cursor:resume": "pwsh -File scripts/agent/cursor-gap-closer.ps1 -Resume",
    "cursor:process": "pwsh -File scripts/cursor-agent-processor.ps1",
    "cursor:process-all": "pwsh -File scripts/cursor-agent-processor.ps1 -ProcessAll",
    "cursor:list-tasks": "pwsh -File scripts/cursor-agent-processor.ps1 -ListTasks",
    "cursor:task": "pwsh -File scripts/cursor-agent-processor.ps1 -TaskId",
    "cursor:monitor:start": "pwsh -File scripts/cursor-agent-monitor.ps1 -StartMonitoring",
    "cursor:monitor:stop": "pwsh -File scripts/cursor-agent-monitor.ps1 -StopMonitoring",
    "cursor:monitor:status": "pwsh -File scripts/cursor-agent-monitor.ps1 -Status",
    "cursor:inject": "pwsh -File scripts/agent/recurring-job-injector.ps1",
    "cursor:inject-dry": "pwsh -File scripts/agent/recurring-job-injector.ps1 -DryRun"
  },
  "keywords": [
    "observability",
    "otel",
    "signoz",
    "ecrr",
    "windows"
  ],
  "author": "Observability Copilot",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
