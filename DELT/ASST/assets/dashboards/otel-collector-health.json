{
  "dashboard": {
    "title": "OTel Collector Health",
    "description": "OpenTelemetry Collector health monitoring dashboard",
    "tags": ["otel", "collector", "health"],
    "panels": [
      {
        "title": "Exporter Queue Fill (%)",
        "type": "stat",
        "targets": [
          {
            "queryType": "promql",
            "query": "sum(otelcol_exporter_queue_size) / clamp_max(sum(otelcol_exporter_queue_capacity), 1) * 100"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 25},
                {"color": "red", "value": 50}
              ]
            }
          }
        }
      },
      {
        "title": "Export Failures (5m rate)",
        "type": "stat",
        "targets": [
          {
            "queryType": "promql",
            "query": "sum(rate(otelcol_exporter_send_failed_spans[5m])) + sum(rate(otelcol_exporter_send_failed_logs[5m]))"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 0.1}
              ]
            }
          }
        }
      },
      {
        "title": "Receiver Throughput (logs/sec)",
        "type": "stat",
        "targets": [
          {
            "queryType": "promql",
            "query": "sum(rate(otelcol_receiver_accepted_logs[5m]))"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "logs/sec"
          }
        }
      },
      {
        "title": "Collector Memory (MiB)",
        "type": "stat",
        "targets": [
          {
            "queryType": "promql",
            "query": "sum(otelcol_process_memory_rss) / 1024 / 1024"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "mibytes"
          }
        }
      },
      {
        "title": "Recent Collector Status Pings",
        "type": "table",
        "targets": [
          {
            "queryType": "clickhouse_sql",
            "query": "SELECT timestamp, JSONExtractString(body, 'status') as status, JSONExtractString(body, 'message') as message FROM signoz_logs.logs_v2 WHERE JSONExtractString(body, 'dataset') = 'collector_health' ORDER BY timestamp DESC LIMIT 10"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}