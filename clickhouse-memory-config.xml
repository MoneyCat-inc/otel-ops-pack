<?xml version="1.0"?>
<!--
  ClickHouse server-level memory cap.

  Context: the container hard limit is 3G (docker-compose.yml). ClickHouse's
  default max_server_memory_usage is max_server_memory_usage_to_ram_ratio (0.9)
  of cgroup total (~2.7 GiB on a 3G container), which is above the observed
  resident peak of 1.83 GiB but leaves no headroom for merge spikes. Setting
  an explicit 2.5 GiB cap keeps ClickHouse below the container OOM threshold
  while giving ~650 MiB buffer.

  max_server_memory_usage_to_ram_ratio must stay > 0. ClickHouse 25.12 computes
  ratio * cgroup RAM as the ceiling; if ratio is 0 it lowers the absolute cap to
  0 (unlimited) — observed 2026-09-02 on first apply. With a 3G container:
    0.9 * 3 GiB = 2.7 GiB (ratio ceiling)
    2.5 GiB absolute is lower, so the explicit cap wins.

  Mounted by docker-compose.yml as /etc/clickhouse-server/config.d/memory.xml.
  Revisit if resident peak consistently exceeds 2 GiB (raise cap or reduce load).

  After any change here, confirm each key shows changed=1 in system.server_settings:
  unknown config.d keys fail silently (#742 lesson).
-->
<clickhouse>
    <max_server_memory_usage>2684354560</max_server_memory_usage><!-- 2.5 GiB -->
    <max_server_memory_usage_to_ram_ratio>0.9</max_server_memory_usage_to_ram_ratio>

    <!-- Soft ceiling for background merges + mutations combined (2026-09-03). Observed under
         the 2.5 GiB cap: the system.text_log merge-retry loop held
         MergesMutationsMemoryTracking at ~1.9 GiB every hour, leaving SigNoz inserts to fail
         with code 241. Above this value ClickHouse schedules no NEW merges until usage drops.
         A single oversized merge can still exceed it - this bounds stacking, not one bad
         merge; the bad merge is removed by the operator TRUNCATE (docs/DOCKER_VHDX_MAINTENANCE.md). -->
    <merges_mutations_memory_usage_soft_limit>1073741824</merges_mutations_memory_usage_soft_limit><!-- 1 GiB -->
</clickhouse>
