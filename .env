# SigNoz/OTel Docker Stack Environment Configuration
# Generated for rebuilt Docker setup

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# NextAuth.js secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="local-nextauth-secret-key-for-development"

# NextAuth.js URL
NEXTAUTH_URL="http://localhost:3000"

# User ID hashing salt - generate with: openssl rand -base64 32
USER_HASH_SALT="local-user-hash-salt-for-development"

# =============================================================================
# SIGNOZ CONFIGURATION
# =============================================================================

# SigNoz JWT secret for authentication
SIGNOZ_JWT_SECRET="local-signoz-jwt-secret-rotate"

# =============================================================================
# OBSERVABILITY CONFIGURATION
# =============================================================================

# SigNoz OTLP endpoints
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT="http://localhost:4318"

# Service configuration
OTEL_SERVICE_NAME="resonai-backend"
OTEL_SERVICE_VERSION="1.0.0"
OTEL_ENVIRONMENT="production"

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Node environment
NODE_ENV="production"

# Enable debug logging
DEBUG="false"

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# SigNoz API configuration
SIGNOZ_API_URL="http://localhost:8080/api/v1"
SIGNOZ_API_KEY=""

# Health check configuration
HEALTH_CHECK_INTERVAL_MS="60000"
HEALTH_CHECK_TIMEOUT_MS="5000"

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Performance settings
MAX_REQUEST_SIZE="1048576"
REQUEST_TIMEOUT_MS="30000"
RESPONSE_TIMEOUT_MS="10000"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Security settings
ENABLE_RATE_LIMITING="true"
ENABLE_CORS="true"
ENABLE_SECURITY_HEADERS="true"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level
LOG_LEVEL="info"

# Enable metrics, tracing, and logging
ENABLE_METRICS="true"
ENABLE_TRACING="true"
ENABLE_LOGGING="true"
