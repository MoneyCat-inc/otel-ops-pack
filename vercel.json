# Resonai Backend - Vercel Deployment Configuration

# Vercel configuration for Resonai backend deployment
{
  "version": 2,
  "name": "resonai-backend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "OTEL_SERVICE_NAME": "resonai-backend",
    "OTEL_SERVICE_VERSION": "1.0.0",
    "OTEL_ENVIRONMENT": "production"
  },
  "functions": {
    "app/api/**/*.ts": {
      "runtime": "nodejs18.x",
      "maxDuration": 30
    }
  },
  "regions": ["iad1", "sfo1", "lhr1", "sin1"],
  "framework": "nextjs"
}
