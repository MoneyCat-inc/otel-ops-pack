{
  // Keep this repo responsive (very large docs trees + many generated artifacts)
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.agent/logs/**": true,
    "**/artifacts/**": true,
    "**/logs/**": true,
    "**/queue/**": true,
    "**/backup/**": true,
    "**/state/**": true,
    "**/tmp/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/CHAR/**": true
  },
  "search.exclude": {
    "**/.agent/logs/**": true,
    "**/artifacts/**": true,
    "**/logs/**": true,
    "**/queue/**": true,
    "**/backup/**": true,
    "**/state/**": true,
    "**/tmp/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/CHAR/**": true
  },

  // Formatting: respect repo .editorconfig/.prettierrc
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.eol": "\n",

  // Default formatters per file type
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[powershell]": { "editor.defaultFormatter": "ms-vscode.powershell" },

  // ESLint: let it drive JS/TS diagnostics in-editor
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.useFlatConfig": false,

  // Cursor/VSCode suggestions: keep deterministic edits
  "editor.inlineSuggest.enabled": false,

  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.tsserver.watchOptions": {
    "watchDirectory": "useFsEvents"
  },
  "git.ignoreLimitWarning": true,

  // Prefer PowerShell in integrated terminals (repo is PowerShell-heavy)
  "terminal.integrated.defaultProfile.windows": "PowerShell",

  // Cursor/VS Code npm task detection wraps openTextDocument failures as
  // "failed to parse …/package.json" even when the JSON is valid (large
  // workspace race). Scripts still run via `pnpm run …` in the terminal.
  "npm.autoDetect": "off"
}
