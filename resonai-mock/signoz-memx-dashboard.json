{
  "version": "1.0",
  "name": "MEMX Memory Observation Dashboard",
  "description": "Real-time monitoring of MEMX memory metrics, performance, and strain events",
  "panels": [
    {
      "id": "memx-overview",
      "title": "MEMX Overview",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(memx_frames_total[5m]))",
          "legendFormat": "Frames/sec"
        },
        {
          "expr": "avg(memx_memory_strain_percent)",
          "legendFormat": "Avg Strain %"
        },
        {
          "expr": "max(memx_wasm_heap_bytes)",
          "legendFormat": "Peak WASM Heap"
        },
        {
          "expr": "avg(memx_sab_usage_percent)",
          "legendFormat": "Avg SAB Usage %"
        }
      ]
    },
    {
      "id": "memx-wasm-heap",
      "title": "WASM Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "memx_wasm_heap_bytes",
          "legendFormat": "WASM Heap Bytes"
        },
        {
          "expr": "memx_wasm_heap_bytes{quantile=\"0.95\"}",
          "legendFormat": "P95 WASM Heap"
        }
      ],
      "yAxes": [
        {
          "label": "Bytes",
          "min": 0
        }
      ],
      "thresholds": [
        {
          "value": 10485760,
          "color": "yellow",
          "op": "gt"
        },
        {
          "value": 20971520,
          "color": "red",
          "op": "gt"
        }
      ]
    },
    {
      "id": "memx-sab-usage",
      "title": "SharedArrayBuffer Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "memx_sab_usage_percent",
          "legendFormat": "SAB Usage %"
        },
        {
          "expr": "memx_sab_capacity_bytes",
          "legendFormat": "SAB Capacity"
        }
      ],
      "yAxes": [
        {
          "label": "Percentage / Bytes",
          "min": 0,
          "max": 100
        }
      ],
      "thresholds": [
        {
          "value": 80,
          "color": "yellow",
          "op": "gt"
        },
        {
          "value": 95,
          "color": "red",
          "op": "gt"
        }
      ]
    },
    {
      "id": "memx-worklet-lag",
      "title": "AudioWorklet Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "memx_worklet_lag_ms",
          "legendFormat": "Worklet Lag (ms)"
        },
        {
          "expr": "memx_worklet_lag_ms{quantile=\"0.95\"}",
          "legendFormat": "P95 Worklet Lag"
        }
      ],
      "yAxes": [
        {
          "label": "Milliseconds",
          "min": 0
        }
      ],
      "thresholds": [
        {
          "value": 50,
          "color": "yellow",
          "op": "gt"
        },
        {
          "value": 100,
          "color": "red",
          "op": "gt"
        }
      ]
    },
    {
      "id": "memx-memory-strain",
      "title": "Memory Strain Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "memx_memory_strain_percent",
          "legendFormat": "Memory Strain %"
        },
        {
          "expr": "rate(memx_strain_events_total[5m])",
          "legendFormat": "Strain Events/sec"
        }
      ],
      "yAxes": [
        {
          "label": "Percentage / Events/sec",
          "min": 0,
          "max": 100
        }
      ],
      "thresholds": [
        {
          "value": 50,
          "color": "yellow",
          "op": "gt"
        },
        {
          "value": 80,
          "color": "red",
          "op": "gt"
        }
      ]
    },
    {
      "id": "memx-frame-budget",
      "title": "Frame Budget & Performance",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "memx_frame_budget_ms",
          "legendFormat": "Frame Budget (ms)"
        },
        {
          "expr": "memx_dropped_frames_total",
          "legendFormat": "Dropped Frames"
        }
      ],
      "yAxes": [
        {
          "label": "Milliseconds / Count",
          "min": 0
        }
      ],
      "thresholds": [
        {
          "value": 16.67,
          "color": "yellow",
          "op": "lt"
        },
        {
          "value": 8.33,
          "color": "red",
          "op": "lt"
        }
      ]
    },
    {
      "id": "memx-export-metrics",
      "title": "Export & Session Metrics",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "rate(memx_exports_total[5m])",
          "legendFormat": "Exports/sec"
        },
        {
          "expr": "memx_session_duration_seconds",
          "legendFormat": "Session Duration"
        },
        {
          "expr": "memx_session_frame_count",
          "legendFormat": "Session Frame Count"
        }
      ],
      "yAxes": [
        {
          "label": "Rate / Seconds / Count",
          "min": 0
        }
      ]
    },
    {
      "id": "memx-strain-events-log",
      "title": "Strain Events Log",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "{dataset=\"resonai_analytics\"} |= \"MEMX\" |= \"strain\"",
          "legendFormat": "MEMX Strain Events"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showLineNumbers": true,
        "enableLogDetails": true
      }
    },
    {
      "id": "memx-otel-health",
      "title": "OTel Integration Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 36 },
      "targets": [
        {
          "expr": "up{job=\"otel-collector\"}",
          "legendFormat": "OTel Collector"
        },
        {
          "expr": "up{job=\"signoz\"}",
          "legendFormat": "SigNoz"
        }
      ],
      "thresholds": [
        {
          "value": 1,
          "color": "green",
          "op": "eq"
        },
        {
          "value": 0,
          "color": "red",
          "op": "eq"
        }
      ]
    },
    {
      "id": "memx-error-rate",
      "title": "MEMX Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 36 },
      "targets": [
        {
          "expr": "rate(memx_errors_total[5m])",
          "legendFormat": "Errors/sec"
        },
        {
          "expr": "rate(memx_errors_total[5m]) / rate(memx_frames_total[5m]) * 100",
          "legendFormat": "Error Rate %"
        }
      ],
      "thresholds": [
        {
          "value": 0.1,
          "color": "yellow",
          "op": "gt"
        },
        {
          "value": 1,
          "color": "red",
          "op": "gt"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "time_range",
        "type": "interval",
        "options": [
          { "text": "5m", "value": "5m" },
          { "text": "15m", "value": "15m" },
          { "text": "1h", "value": "1h" },
          { "text": "6h", "value": "6h" },
          { "text": "24h", "value": "24h" }
        ],
        "current": { "text": "1h", "value": "1h" }
      },
      {
        "name": "browser",
        "type": "query",
        "query": "label_values(memx_wasm_heap_bytes, browser)",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "MEMX Deployments",
        "type": "tags",
        "tags": ["deployment", "memx"]
      },
      {
        "name": "Strain Events",
        "type": "logs",
        "expr": "{dataset=\"resonai_analytics\"} |= \"MEMX\" |= \"strain\""
      }
    ]
  },
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "UTC"
}
