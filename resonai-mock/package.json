{
  "name": "resonai-mock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --workers=1 --retries=0 --reporter=list,json",
    "e2e:grep:noflake": "playwright test --grep-invert @flaky --workers=1 --retries=0",
    "e2e:grep:flaky": "playwright test --grep @flaky --workers=4 --retries=3",
    "e2e:pr": "playwright test --project=firefox --grep-invert @flaky",
    "e2e:pr:mobile": "playwright test --project=android --grep-invert @flaky",
    "e2e:nightly": "playwright test --retries=2",
    "e2e:ci": "playwright test --reporter=./tools/pw-json-reporter.js",
    "smoke": "pnpm test:unit && pnpm e2e:grep:noflake",
    "e2e:report": "npx playwright show-report",
    "ssot": "npx ts-node scripts/ci/emit-ssot.ts",
    "test:ui": "vitest --ui",
    "ci": "npm run lint && npm run typecheck && npm run test:unit",
    "qa:full": "pnpm test:unit && pnpm test:e2e --reporter=list",
    "qa:a11y": "pnpm test:e2e --grep @a11y-smokes",
    "qa:isolation": "pnpm test:e2e --grep @isolation-offline",
    "qa:prosody": "pnpm test:e2e --grep @prosody-scenarios",
    "qa:strain": "pnpm test:e2e --grep @strain",
    "qa:progress": "pnpm test:e2e --grep @progress",
    "qa:data": "pnpm test:e2e --grep @data-control",
    "qa:summary": "tsx scripts/qa-summary.ts",
    "qa:env-check": "node -e \"console.log('Node:', process.version); console.log('PNPM:', require('child_process').execSync('pnpm --version', {encoding:'utf8'}).trim())\"",
    "qa:cleanup": "if exist playwright-report.json del playwright-report.json && if exist test-results rmdir /s /q test-results && if exist .next rmdir /s /q .next",
    "qa:reset-browsers": "pnpm test:e2e --grep @reset",
    "qa:clear-cache": "if exist .next rmdir /s /q .next && if exist node_modules\\.cache rmdir /s /q node_modules\\.cache",
    "qa:check-headers": "curl -I http://localhost:3000 | grep -i 'cross-origin'",
    "qa:check-sw": "curl -I http://localhost:3000/sw.js | grep -i 'service-worker'",
    "qa:check-a11y": "pnpm test:e2e --grep @a11y-smokes --reporter=line",
    "fixtures:prosody": "node scripts/generate-fixtures.js prosody",
    "fixtures:strain": "node scripts/generate-fixtures.js strain",
    "fixtures:isolation": "node scripts/generate-fixtures.js isolation",
    "fixtures:regenerate": "pnpm fixtures:prosody && pnpm fixtures:strain && pnpm fixtures:isolation"
  },
  "dependencies": {
    "dexie": "^3.2.7",
    "next": "14.2.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^18.0.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.0.0",
    "jest": "^29.7.0",
    "jsdom": "^27.0.0",
    "vite": "7.1.9",
    "vitest": "^3.2.4"
  }
}
