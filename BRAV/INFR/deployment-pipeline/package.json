{
  "name": "deployment-pipeline-api",
  "version": "1.0.0",
  "description": "Minimal REST API for deployment pipeline validation",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "build": "echo 'Build completed'",
    "docker:build": "docker build -t deployment-pipeline-api .",
    "docker:run": "docker run -p 3000:3000 deployment-pipeline-api"
  },
  "keywords": [
    "rest-api",
    "express",
    "deployment-pipeline",
    "codex-local",
    "tetragrammaton"
  ],
  "author": "Codex Local Test",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "morgan": "^1.12.0",
    "resonai-backend": "file:../../.."
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
