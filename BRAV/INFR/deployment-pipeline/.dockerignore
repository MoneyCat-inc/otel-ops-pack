# Docker ignore file for Deployment Pipeline API
# Exclude unnecessary files from Docker build context

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
test-results/
*.test.js
*.spec.js

# Development
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
docs/
*.md

# CI/CD
.github/
.gitlab-ci.yml

# Kubernetes
k8s/
*.yaml
*.yml

# Build artifacts
dist/
build/
*.tar.gz
*.zip

# Logs
logs/
*.log
