{
  "version": "1.0.0",
  "description": "Tetragram repository structure guardrails - BossCat OEM governance",
  "rules": {
    "allowed_top_level": [
      ".agent",
      ".cursor",
      ".cursorignore",
      ".cursorrules",
      ".devskim.json",
      ".dockerignore",
      ".editorconfig",
      ".env.example",
      ".eslintrc.js",
      ".git",
      ".gitattributes",
      ".gitguardian.yml",
      ".github",
      ".gitignore",
      ".gitleaks.toml",
      ".gitmessage",
      ".gitmodules",
      ".lefthook-local.yml.example",
      ".lychee.toml",
      ".markdownlint-cli2.yaml",
      ".markdownlint.json",
      ".mergify.yml",
      ".next",
      ".node-version",
      ".nojekyll",
      ".nvmrc",
      ".pre-commit-config.yaml",
      ".prettierrc",
      ".vscode",
      ".well-known",
      ".yamllint",
      "AGENTS.md",
      "ALFA",
      "BRAV",
      "CHANGELOG.md",
      "CHAR",
      "CNAME",
      "CODEOWNERS",
      "CODE_OF_CONDUCT.md",
      "CONTRIBUTING.md",
      "DELT",
      "Dockerfile",
      "Dockerfile.demo",
      "Dockerfile.dev",
      "Dockerfile.gpu-base",
      "LICENSE",
      "NOTICE",
      "PSScriptAnalyzerSettings.psd1",
      "QUICKSTART.md",
      "README.md",
      "RESTORE_DEPENDENCIES.md",
      "SECURITY.md",
      "STATUS.md",
      "TASKS.md",
      "_config.yml",
      "ai-assistant-config.yaml",
      "ai-assistant-helper.ps1",
      "artifacts",
      "assets",
      "azure-pipelines-ecrr.yml",
      "canary-check-min.ps1",
      "canary-check.ps1",
      "canary-monitor.ps1",
      "canary-test.ps1",
      "clickhouse-cluster-config.xml",
      "clickhouse-mergetree-compat-config.xml",
      "clickhouse-system-logs-config.xml",
      "clickhouse-users-profile-config.xml",
      "clickhouse-zookeeper-config.xml",
      "compose",
      "compose/docker-compose.unified.yml",
      "compose/legacy.yml",
      "config.yaml",
      "docker-compose.yml",
      "docs",
      "dotnet-test-app",
      "env.template",
      "favicon.svg",
      "gpu-metrics-emitter.py",
      "gpu-metrics-simple.py",
      "gpu-monitor.ps1",
      "green-sheet.ps1",
      "health-check.ps1",
      "humans.txt",
      "index.html",
      "instrumentation-simple.js",
      "instrumentation.ts",
      "integration-tests.ps1",
      "jest-ts-transform.cjs",
      "jest.config.ts",
      "kafka-smoke.ps1",
      "lefthook.yml",
      "make-audit-pack.ps1",
      "next-env.d.ts",
      "next.config.js",
      "node_modules",
      "og",
      "otel-agent-coordination",
      "otel-demo-app.js",
      "package.json",
      "pfac_run.py",
      "playwright.config.ts",
      "playwright.signoz.config.ts",
      "playwright.smoke.config.ts",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "portal.html",
      "queue-steward-dashboard.json",
      "requirements.txt",
      "robots.txt",
      "rolling_run.py",
      "run-gpu-metrics.ps1",
      "safe-apply-config.ps1",
      "schema",
      "scripts",
      "send-canary-trace-direct.ps1",
      "signature-registry.json",
      "signoz-alerts.json",
      "signoz-collector-config.yaml",
      "signoz-ecrr-canary-alert.json",
      "signoz-health-canary-alert.json",
      "signoz-memory-alert.json",
      "signoz-metrics-canary-alert.json",
      "signoz-queue-pressure-dashboard.json",
      "signoz-windows-logs-canary-alert.json",
      "signoz-writer.yaml",
      "start-signoz.ps1",
      "startup-observability.ps1",
      "third_party",
      "tsconfig.base.json",
      "tsconfig.json",
      "windows"
    ],
    "forbidden_legacy_roots": [
      "config",
      "configs",
      "docker",
      "helm",
      "deployment-pipeline",
      "reports",
      "playwright-report",
      "synthetic",
      "tests",
      "tools",
      "backups",
      "archive",
      "baseline",
      "~"
    ],
    "ephemeral_top_level": [
      "logs",
      "out",
      "tmp",
      ".cache",
      "coverage",
      "dist",
      "build",
      ".next",
      "gpu-buffers",
      "sidecars",
      "artifacts",
      "DELT/ARTF"
    ],
    "ignore_untracked_top_level": false,
    "max_path_depth": 7,
    "tetragram_structure": {
      "ALFA": {
        "description": "Application plane - source code, instrumentation, apps",
        "subdirs": [
          "APPS",
          "CORE",
          "LIBS",
          "OTEL",
          "TEST",
          "TOOL"
        ]
      },
      "BRAV": {
        "description": "Build/Runtime/Automation/Verification plane - scripts, infra, CI/CD",
        "subdirs": [
          "DOCK",
          "INFR",
          "SCPT"
        ]
      },
      "CHAR": {
        "description": "Compliance/Human/Audit/Review plane - docs, reports, evidence",
        "subdirs": [
          "DOCS",
          "ECRR",
          "EVID",
          "PRSV"
        ]
      },
      "DELT": {
        "description": "Data/Environment/Load/Test plane - configs, fixtures, test data, artifacts",
        "subdirs": [
          "ARTF",
          "ASST",
          "CONF",
          "FIXT",
          "TMPL"
        ]
      }
    },
    "ci_workflow_rules": {
      "max_inline_run_lines": 40,
      "require_brav_scpt_reference": true,
      "allowed_workflow_paths": [
        ".github/workflows"
      ]
    },
    "forbidden_globs": [
      "**/*.env",
      "**/*.pem",
      "**/*.pfx",
      "**/*id_rsa*",
      "**/*.key",
      "**/.DS_Store",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/*AWS_ACCESS_KEY_ID*",
      "**/*AWS_SECRET_ACCESS_KEY*"
    ]
  },
  "exemptions": {
    "hidden_dirs": [
      ".agent",
      ".cursor",
      ".git",
      ".github",
      ".idea",
      ".kiro",
      ".next",
      ".vscode",
      "node_modules"
    ],
    "temp_dirs": [
      "__pycache__"
    ],
    "build_dirs": [
      "dist",
      "build",
      "target",
      "coverage",
      "venv",
      ".venv",
      ".pytest_cache",
      ".mypy_cache",
      "__pycache__"
    ]
  },
  "enforcement": {
    "mode": "fail",
    "report_format": "github_actions",
    "exit_code_on_violation": 1
  }
}
