{
  "dashboard": {
    "id": null,
    "title": "codex-local Autonomous Observability",
    "tags": ["codex-local", "autonomous", "observability"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Jobs Processed Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(codex_jobs_processed_total[5m])",
            "legendFormat": "Jobs/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.1
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "ops"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Guardrail Violations",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(codex_guardrail_violations_total[1h])",
            "legendFormat": "Violations/hour"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Watchdog Cycle Duration (p95)",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(watchdog_cycle_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 Duration"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 300
                },
                {
                  "color": "red",
                  "value": 600
                }
              ]
            },
            "unit": "s"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "Fleet Health Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (state) (codex_fleet_repos_total)",
            "legendFormat": "{{state}}"
          }
        ],
        "options": {
          "pieType": "pie",
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "Policy Compliance Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(codex_policy_compliance_total[5m])",
            "legendFormat": "Compliance Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.8
                },
                {
                  "color": "green",
                  "value": 0.95
                }
              ]
            },
            "unit": "percentunit"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 6,
        "title": "Service Health Timeline",
        "type": "timeseries",
        "targets": [
          {
            "expr": "codex_service_health_score",
            "legendFormat": "Health Score"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "green",
                  "value": 90
                }
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 30,
    "version": 1,
    "links": [
      {
        "title": "codex-local Repository",
        "url": "https://github.com/resonai/codex-local",
        "type": "link"
      },
      {
        "title": "OpenTelemetry Alignment",
        "url": "https://github.com/resonai/codex-local/blob/main/docs/OPEN_TELEMETRY_ALIGNMENT.md",
        "type": "link"
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Guardrail Violations",
          "datasource": "prometheus",
          "enable": true,
          "expr": "increase(codex_guardrail_violations_total[1h]) > 10",
          "titleFormat": "Guardrail Spike",
          "textFormat": "Violations exceeded threshold"
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "query": "label_values(codex_jobs_processed_total, service_name)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    }
  }
}
