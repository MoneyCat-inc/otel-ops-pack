{
  "dashboard": {
    "title": "Comprehensive Fractal Pattern Monitoring Dashboard",
    "description": "Complete observability dashboard for fractal pattern analysis, Hurst exponent monitoring, and drift detection",
    "refreshInterval": "30s",
    "timeRange": "24h",
    "panels": [
      {
        "id": "hurst-exponent-trends",
        "title": "Hurst Exponent Trends by Pattern",
        "type": "time_series",
        "query": {
          "queryType": "logs",
          "logsQuery": {
            "query": "message contains \"hurst_estimate\" AND log.file.path contains \"canary-pattern-results.json\"",
            "groupBy": ["pattern"],
            "legendFormat": "{{pattern}} Pattern Hurst"
          }
        },
        "yAxis": {
          "min": 0,
          "max": 1,
          "thresholds": [
            {"value": 0.3, "color": "red", "label": "Anti-persistent"},
            {"value": 0.7, "color": "yellow", "label": "Persistent Alert"},
            {"value": 1.0, "color": "red", "label": "Strong Persistence"}
          ]
        },
        "description": "Track Hurst exponent values over time for each pattern type with alert thresholds"
      },
      {
        "id": "pattern-event-counts",
        "title": "Pattern Event Counts",
        "type": "table",
        "query": {
          "queryType": "logs",
          "logsQuery": {
            "query": "message contains \"windows-canary\"",
            "groupBy": ["pattern"],
            "legendFormat": "{{pattern}} Events"
          }
        },
        "description": "Monitor event counts for each pattern type to ensure adequate sample sizes"
      },
      {
        "id": "drift-alert-status",
        "title": "Hurst Drift Alert Status",
        "type": "stat",
        "query": {
          "queryType": "logs",
          "logsQuery": {
            "query": "alert_name = \"Hurst Exponent Drift Alert\"",
            "legendFormat": "Drift Alert Status"
          }
        },
        "thresholds": [
          {"value": 0, "color": "green", "label": "OK"},
          {"value": 1, "color": "red", "label": "Alert"}
        ],
        "description": "Current status of Hurst exponent drift detection alert"
      },
      {
        "id": "coefficient-of-variation",
        "title": "Coefficient of Variation by Pattern",
        "type": "time_series",
        "query": {
          "queryType": "logs",
          "logsQuery": {
            "query": "message contains \"coefficient_of_variation\" AND log.file.path contains \"enhanced-statistical-validation.json\"",
            "groupBy": ["pattern"],
            "legendFormat": "{{pattern}} CV"
          }
        },
        "description": "Monitor coefficient of variation as a robust validation metric alongside Hurst exponent"
      },
      {
        "id": "sample-size-monitoring",
        "title": "Sample Size Monitoring",
        "type": "table",
        "query": {
          "queryType": "logs",
          "logsQuery": {
            "query": "message contains \"sample_size\" AND log.file.path contains \"enhanced-statistical-validation.json\"",
            "groupBy": ["pattern"],
            "legendFormat": "{{pattern}} Sample Size"
          }
        },
        "description": "Track sample sizes to ensure statistical reliability (minimum 50 events recommended)"
      },
      {
        "id": "confidence-intervals",
        "title": "95% Confidence Intervals",
        "type": "time_series",
        "query": {
          "queryType": "logs",
          "logsQuery": {
            "query": "message contains \"confidence_interval\" AND log.file.path contains \"enhanced-statistical-validation.json\"",
            "groupFormat": "{{pattern}} CI"
          }
        },
        "description": "Display 95% confidence intervals for Hurst exponent estimates to show statistical uncertainty"
      },
      {
        "id": "statistical-significance",
        "title": "Statistical Significance Status",
        "type": "stat",
        "query": {
          "queryType": "logs",
          "logsQuery": {
            "query": "message contains \"significant_deviation\" AND log.file.path contains \"enhanced-statistical-validation.json\"",
            "legendFormat": "Significant Deviations"
          }
        },
        "thresholds": [
          {"value": 0, "color": "green", "label": "Normal"},
          {"value": 1, "color": "yellow", "label": "Deviant"},
          {"value": 2, "color": "red", "label": "Significant"}
        ],
        "description": "Monitor for statistically significant deviations from expected Hurst values"
      },
      {
        "id": "daily-automation-status",
        "title": "Daily Automation Status",
        "type": "stat",
        "query": {
          "queryType": "logs",
          "logsQuery": {
            "query": "message contains \"Daily Canary Pattern Drills\"",
            "legendFormat": "Automation Status"
          }
        },
        "thresholds": [
          {"value": 0, "color": "red", "label": "Not Running"},
          {"value": 1, "color": "green", "label": "Active"}
        ],
        "description": "Monitor the status of daily automated pattern drill execution"
      }
    ],
    "variables": [
      {
        "name": "pattern",
        "type": "query",
        "query": "pattern",
        "multi": true,
        "includeAll": true,
        "description": "Pattern type filter"
      },
      {
        "name": "timeRange",
        "type": "interval",
        "options": ["5m", "15m", "1h", "6h", "24h", "7d"],
        "description": "Time range selection"
      }
    ]
  },
  "alerts": [
    {
      "name": "Hurst Exponent Drift Alert",
      "description": "Detects significant drift in Hurst exponent values",
      "query": "message contains \"hurst_estimate\" AND log.file.path contains \"canary-pattern-results.json\"",
      "condition": {
        "threshold": 0.7,
        "operator": "above",
        "evaluationWindow": "15m"
      }
    },
    {
      "name": "Sample Size Insufficient",
      "description": "Alerts when sample size falls below minimum threshold",
      "query": "message contains \"sample_size\" AND log.file.path contains \"enhanced-statistical-validation.json\"",
      "condition": {
        "threshold": 50,
        "operator": "below",
        "evaluationWindow": "30m"
      }
    },
    {
      "name": "Daily Automation Failure",
      "description": "Alerts when daily automation fails to run",
      "query": "message contains \"Daily Canary Pattern Drills\"",
      "condition": {
        "threshold": 1,
        "operator": "below",
        "evaluationWindow": "25h"
      }
    }
  ]
}
