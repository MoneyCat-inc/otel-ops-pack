{
  "alert": {
    "name": "Health Canary Metrics Missing",
    "description": "Health canary metrics missing from Windows collector pipeline. Expected metrics every 5 minutes, but none received in last 5 minutes. Current value: {{$value}} metrics in last 5 minutes. Threshold: {{$threshold}} (minimum expected).",
    "severity": "warning",
    "labels": {
      "service": "windows-collector",
      "component": "health-check",
      "severity": "warning",
      "environment": "local"
    },
    "query": {
      "queryType": "metrics",
      "metricsQuery": {
        "query": "up{service=\"windows-collector\"}",
        "groupBy": ["service"],
        "legendFormat": "{{service}} - Health Status"
      }
    },
    "condition": {
      "threshold": 1,
      "operator": "below",
      "evaluationWindow": "5m",
      "alertFrequency": "1m",
      "notificationOnMissingData": true,
      "minimumDataPoints": 1
    },
    "notificationChannels": [
      "email-default",
      "slack-default"
    ]
  }
}
