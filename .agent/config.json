{
  "max_jobs_per_run": 3,
  "max_files_per_job": 15,
  "max_lines_per_job": 500,
  "job_ttl_seconds": 86400,
  "agent_name": "Cursor-Assistant",
  "version": "1.0.0",
  "environment": "resonai-otel",
  "capabilities": [
    "code_navigation",
    "text_extraction", 
    "script_execution",
    "patch_preparation",
    "reporting",
    "observability_analysis",
    "config_validation",
    "integration_testing"
  ],
  "safety_settings": {
    "read_only_by_default": true,
    "require_confirmation": true,
    "max_file_size_mb": 25,
    "excluded_directories": [
      "node_modules",
      ".git",
      "third_party",
      ".agent/logs",
      ".agent/reports",
      "audit"
    ],
    "allowed_file_extensions": [
      ".ps1", ".yaml", ".yml", ".json", ".md", ".txt", ".log",
      ".ts", ".tsx", ".js", ".jsx", ".py", ".go", ".rs"
    ]
  },
  "resonai_integration": {
    "otel_config_path": "C:\\otel\\config.yaml",
    "ai_assistant_config": "C:\\otel\\ai-assistant-config.yaml",
    "templates_path": "C:\\otel\\templates",
    "logs_path": "C:\\otel\\logs",
    "monitoring_enabled": true
  },
  "logging": {
    "level": "INFO",
    "log_to_file": true,
    "include_timestamps": true,
    "log_file_pattern": ".agent/logs/agent-{date}.log",
    "max_log_files": 30,
    "max_log_size_mb": 10
  },
  "performance": {
    "timeout_seconds": 60,
    "memory_limit_mb": 512,
    "parallel_jobs": 2
  },
  "notifications": {
    "health_check_failures": true,
    "job_completion": false,
    "error_alerts": true
  }
}
