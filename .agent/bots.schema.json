{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BossCat Bots",
  "description": "Tetragram 4-4-4-4 bot registry: SET-SET-LANE-ROLE",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["code"],
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^(AUTO-BOTS|IONA-CATS)-(SSOT|FLAK|SELE|COMP|DOCS)-(ALFA|BETA)$",
        "description": "4-4-4-4 tetragram: SET-SET-LANE-ROLE"
      },
      "title": {
        "type": "string",
        "description": "Human-readable bot title"
      },
      "task": {
        "type": "string",
        "description": "Primary task description"
      },
      "role": {
        "enum": ["ALFA", "BETA"],
        "description": "NATO spelling: ALFA (writer) or BETA (monitor)"
      },
      "lane": {
        "enum": ["SSOT", "FLAK", "SELE", "COMP", "DOCS"],
        "description": "Lane assignment"
      }
    },
    "additionalProperties": true
  },
  "minItems": 10,
  "description": "Must contain exactly one ALFA and one BETA per lane (5 lanes = 10 bots minimum)"
}

