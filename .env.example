# OTel Ops Pack - Environment Configuration Template
# Copy this file to .env and update values as needed

# =============================================================================
# OpenTelemetry Collector Configuration
# =============================================================================

# OTel Collector OTLP endpoints
OTEL_COLLECTOR_OTLP_GRPC_ENDPOINT=http://localhost:4317
OTEL_COLLECTOR_OTLP_HTTP_ENDPOINT=http://localhost:4318

# SigNoz backend endpoints (for collector export)
SIGNOZ_OTLP_GRPC_ENDPOINT=http://localhost:14317
SIGNOZ_OTLP_HTTP_ENDPOINT=http://localhost:14318

# =============================================================================
# SigNoz Configuration
# =============================================================================

# SigNoz UI access
SIGNOZ_UI_URL=http://localhost:8080
SIGNOZ_UI_USERNAME=admin
SIGNOZ_UI_PASSWORD=admin

# SigNoz ClickHouse database
SIGNOZ_CLICKHOUSE_HOST=localhost
SIGNOZ_CLICKHOUSE_PORT=9000
SIGNOZ_CLICKHOUSE_DATABASE=signoz

# =============================================================================
# Windows Event Log Configuration
# =============================================================================

# Windows Event Log sources to collect
WINDOWS_EVENT_LOG_SOURCES=Application,System,Security
WINDOWS_EVENT_LOG_LEVELS=Error,Warning,Information

# =============================================================================
# File Log Configuration
# =============================================================================

# File log patterns to collect
FILE_LOG_PATTERNS=C:/logs/**/*.log,C:/ProgramData/**/*.log

# =============================================================================
# Monitoring & Alerting
# =============================================================================

# Health check intervals (seconds)
HEALTH_CHECK_INTERVAL=30
CANARY_TEST_INTERVAL=300

# Alert thresholds
ERROR_RATE_THRESHOLD=5.0
TTV_P95_THRESHOLD=2000
ACTIVATION_RATE_THRESHOLD=80.0

# =============================================================================
# Development & Debugging
# =============================================================================

# Log levels
LOG_LEVEL=INFO
DEBUG_MODE=false

# Artifacts directory
ARTIFACTS_PATH=artifacts

# =============================================================================
# Security & Secrets (DO NOT COMMIT REAL VALUES)
# =============================================================================

# API keys and tokens (use GitHub secrets in CI)
# API_KEY=your_api_key_here
# AUTH_TOKEN=your_auth_token_here

# Database credentials (if using external DB)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=otel_ops
# DB_USER=otel_user
# DB_PASSWORD=your_db_password_here
